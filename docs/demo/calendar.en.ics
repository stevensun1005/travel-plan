X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-ADDRESS="2335 Kalākaua Ave, Honolu
 lu";X-APPLE-RADIUS=100;X-TITLE="Duke's Waikiki":geo:21.2768421,-157.827791
 7
