BEGIN:VEVENT
UID:oahu-2027-jan-five-nights-d2-0@travel-plan
DTSTAMP:20261119T193122Z
DTSTART:20270104T163000Z
DTEND:20270104T171500Z
SUMMARY:Jet-lagged early start\, breakfast
DESCRIPTION:You'll wake up early the first few days\, perfect for Pearl Har
 bor. No driving.
END:VEVENT
BEGIN:VEVENT
UID:oahu-2027-jan-five-nights-d2-1@travel-plan
DTSTAMP:20261119T193122Z
DTSTART:20270104T171500Z
DTEND:20270104T180000Z
SUMMARY:Uber to Pearl Harbor
DESCRIPTION:~25 min. No bags allowed\, only small clear bags or phone walle
 ts\; paid bag storage available.\n\nGoogle Maps: https://www.google.com/ma
 ps/search/?api=1&query=Pearl%20Harbor%20Visitor%20Center
LOCATION:Pearl Harbor Visitor Center
GEO:21.3674843;-157.9384488
X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-APPLE-RADIUS=100;X-TITLE="Pearl Har
 bor Visitor Center":geo:21.3674843,-157.9384488
END:VEVENT
BEGIN:VEVENT
UID:oahu-2027-jan-five-nights-d2-2@travel-plan
DTSTAMP:20261119T193122Z
DTSTART:20270104T180000Z
DTEND:20270104T193000Z
SUMMARY:USS Arizona Memorial
DESCRIPTION:Reservations are free\, with only a small booking fee. Released
  on Recreation.gov\; book the earliest slot. Includes a film and boat ride
 \, ~75 min.\n\nRecreation.gov reservations: https://www.recreation.gov/tic
 ket/facility/233338\nGoogle Maps: https://www.google.com/maps/search/?api=
 1&query=USS%20Arizona%20Memorial
LOCATION:USS Arizona Memorial
GEO:21.364906;-157.9500297
X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-APPLE-RADIUS=100;X-TITLE="USS Arizo
 na Memorial":geo:21.364906,-157.9500297
END:VEVENT
BEGIN:VEVENT
UID:oahu-2027-jan-five-nights-d2-3@travel-plan
DTSTAMP:20261119T193122Z
DTSTART:20270104T193000Z
DTEND:20270104T210000Z
SUMMARY:Submarine Museum / USS Bowfin
DESCRIPTION:Right next to the visitor center\; included in the Passport.\n\
 nGoogle Maps: https://www.google.com/maps/search/?api=1&query=Pearl%20Harb
 or%20Bowfin%20Submarine%20Museum
LOCATION:Pearl Harbor Bowfin Submarine Museum
GEO:21.368732;-157.9394436
X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-APPLE-RADIUS=100;X-TITLE="Pearl Har
 bor Bowfin Submarine Museum":geo:21.368732,-157.9394436
END:VEVENT
