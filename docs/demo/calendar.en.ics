X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-ADDRESS="Kalākaua Ave, east end";X
 -APPLE-RADIUS=100;X-TITLE="Waikīkī rental office (sample location)":geo:
 21.2734513,-157.8222713
