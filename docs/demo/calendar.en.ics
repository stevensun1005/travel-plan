DTSTAMP:20261119T193122Z
DTSTART:20270107T003000Z
DTEND:20270107T040000Z
SUMMARY:Ala Moana Center
DESCRIPTION:Pink Line (Ala Moana shopping line) both ways.\n\nGoogle Maps: 
 https://www.google.com/maps/search/?api=1&query=Ala%20Moana%20Center
LOCATION:Ala Moana Center
GEO:21.2911;-157.8435
X-APPLE-STRUCTURED-LOCATION;VALUE=URI;X-APPLE-RADIUS=100;X-TITLE="Ala Moana
  Center":geo:21.2911,-157.8435
